# service-aot — Spring Boot 4.0.x on JDK 25 with Project Leyden AOT cache.
#
# Pipeline (per the JDK 25 / Spring Boot 3.3+ best practice):
#   1. build    - mvn package -> Spring Boot fat JAR
#   2. extract  - java -Djarmode=tools extract -> flat layout
#   3. cache    - boot extracted app with -XX:AOTCacheOutput, hit JPA endpoints,
#                 SIGTERM for clean exit -> writes app.aot directly
#   4. runtime  - ship extracted layout + cache; launch with -XX:AOTCache
#
# The cache stage uses one-shot AOTCacheOutput (JDK 25) instead of the older
# two-step record + create flow. We hit endpoints during training so the cache
# captures method profiles for the JPA query path, not just classloading data.

# ---- Stage 1: Build -----------------------------------------------------
FROM registry.access.redhat.com/ubi9/openjdk-25:1.24 AS build
USER root
WORKDIR /build
COPY pom.xml ./
COPY src ./src
RUN mvn -B -ntp clean package -Dmaven.test.skip=true

# ---- Stage 2: Extract Spring Boot fat JAR -------------------------------
FROM registry.access.redhat.com/ubi9/openjdk-25:1.24 AS extract
USER root
WORKDIR /app
COPY --from=build /build/target/*.jar /app/app.jar
RUN java -Djarmode=tools -jar /app/app.jar extract --destination /app/extracted \
  && ls -la /app/extracted/

# ---- Stage 3: AOT cache creation with onRefresh -------------------------
# Per Piotr Minkowski's writeup of Spring Boot + Project Leyden:
# -Dspring.context.exit=onRefresh causes Spring to exit cleanly immediately
# after the application context is refreshed (all beans constructed and wired).
# The clean JVM exit lets -XX:AOTCacheOutput write the AOT cache containing
# the fully-populated bean factory state. No endpoint warmup needed.
FROM registry.access.redhat.com/ubi9/openjdk-25:1.24 AS cache
USER root
WORKDIR /app
COPY --from=extract /app/extracted /app/extracted

RUN cd /app/extracted && \
    java \
      -XX:AOTCacheOutput=/app/app.aot \
      -Dspring.context.exit=onRefresh \
      -Dspring.jpa.hibernate.ddl-auto=none \
      -jar /app/extracted/app.jar && \
    test -s /app/app.aot && \
    echo "AOT cache written ($(du -h /app/app.aot | cut -f1))"

# ---- Stage 4: Runtime ---------------------------------------------------
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24
USER root
WORKDIR /app

ARG OTEL_AGENT_VERSION=2.26.1
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar /app/opentelemetry-javaagent.jar
RUN chmod 0644 /app/opentelemetry-javaagent.jar

# Ship the extracted layout (matches what the cache was trained against)
COPY --from=extract /app/extracted /app/
COPY --from=cache /app/app.aot /app/app.aot

USER 185
EXPOSE 8080

# Launch the extracted app.jar — AOTCache flag is set in compose.yaml
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
